{
  "name": "notcad",
  "version": "0.1.0",
  "description": "Local-first parametric CAD \u2014 unreleased engineering build",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm test && npm run build && npm run test:e2e",
    "parity": "node scripts/parity.mjs",
    "release:check": "node scripts/parity.mjs --release",
    "format": "prettier --write src tests scripts *.ts *.json docs/*.json"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@salusoft89/planegcs": "1.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "private": true,
  "type": "module"
}
